{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "backend_cluster",
        "Match": {
          "Path": "/api/{**remainder}"
        }
      },
      "results-route": {
        "ClusterId": "backend_cluster",
        "Match": {
          "Path": "/results/{**remainder}"
        }
      }
    },
    "Clusters": {
      "backend_cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "backend_server_1": {
            "Address": "http://localhost:5001"
          },
          "backend_server_2": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}